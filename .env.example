# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., http://localhost:3000 in Docker).
APP_URL="MY_APP_URL"

# Spotify OAuth (optional, required for private/collaborative Spotify playlists & full Spotify search)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Google / YouTube OAuth (optional, required for private/unlisted YouTube playlists)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage directories (used inside Docker or local environment)
DOWNLOAD_DIR="./downloads"
DATA_DIR="./data"
